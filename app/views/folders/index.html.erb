<%= render "shared/logo" %>

<h1>Folders</h1>

<% if @folders.empty? %>
  <p>No folders yet — you can create one from a comic's Save dialog.</p>
<% else %>
  <ul>
    <% @folders.each do |folder| %>
      <li><%= link_to folder.name, folder_path(folder) %></li>
    <% end %>
  </ul>
<% end %>

<%= link_to "Back to My Comics", projects_path %>
