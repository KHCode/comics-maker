<%= render "shared/logo" %>

<%= tag.div flash[:alert], class: "flash flash--alert" if flash[:alert] %>
<%= tag.div flash[:notice], class: "flash flash--notice" if flash[:notice] %>

<h1>Sign in</h1>

<%= form_with url: session_path do |form| %>
  <%= form.label :email %><br>
  <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", value: params[:email] %><br>

  <%= form.label :password %><br>
  <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %><br>

  <%= form.submit "Sign in" %>
<% end %>

<br>
<%= link_to "Create an account", new_user_path %>
