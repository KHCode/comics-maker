<div class="signed-in-bar">
  <%= render "shared/logo" %>
  <div class="signed-in-bar-right">
    <span>Signed in as <%= Current.user.name %></span>
    <%= button_to "Sign out", session_path, method: :delete, form: { class: "inline-form" } %>
  </div>
</div>

<%= tag.div flash[:alert], class: "flash flash--alert" if flash[:alert] %>
<%= tag.div flash[:notice], class: "flash flash--notice" if flash[:notice] %>

<h1>Start a new comic</h1>

<div class="format-cards">
  <% ProjectsHelper::FORMAT_PREVIEWS.each do |format, preview| %>
    <%= button_to projects_path, params: { format: format }, class: "format-card" do %>
      <div class="format-preview format-preview--<%= format %>"></div>
      <div><%= preview[:label] %></div>
      <% if preview[:sublabel] %>
        <small><%= preview[:sublabel] %></small>
      <% end %>
    <% end %>
  <% end %>
</div>

<h2>My Comics</h2>

<%# Folders are tabs right here rather than a separate page (see
    ProjectsController#index and project_tabs_controller.js) — every
    folder and everything filed into it is viewable without leaving this
    page. With no folders yet there's nothing to switch between, so skip
    the tab bar entirely rather than showing a single redundant tab. %>
<% if @folders.any? %>
  <div data-controller="project-tabs">
    <nav class="project-tabs">
      <button type="button" class="project-tab project-tab--active" data-project-tabs-target="tab" data-tab="unfiled" data-action="click->project-tabs#select">My Comics</button>
      <% @folders.each do |folder| %>
        <button type="button" class="project-tab" data-project-tabs-target="tab" data-tab="folder-<%= folder.id %>" data-action="click->project-tabs#select"><%= folder.name %></button>
      <% end %>
    </nav>

    <div data-project-tabs-target="panel" data-tab="unfiled">
      <%= render "projects/project_list", projects: @projects, empty_message: "No comics yet — pick a format above to start one." %>
    </div>

    <% @folders.each do |folder| %>
      <div hidden data-project-tabs-target="panel" data-tab="folder-<%= folder.id %>">
        <%= render "projects/project_list", projects: folder.projects, empty_message: "Nothing in this folder yet." %>
      </div>
    <% end %>
  </div>
<% else %>
  <%= render "projects/project_list", projects: @projects, empty_message: "No comics yet — pick a format above to start one." %>
<% end %>
