<div class="editor" data-controller="editor" data-editor-format-value="<%= @project.format %>" data-editor-page-unit-height-value="<%= @project.page_unit_height %>" data-editor-mode-value="layout" data-editor-direct-upload-url-value="<%= rails_direct_uploads_path %>">
  <header class="editor-header">
    <%= render "shared/logo" %>

    <span class="editor-project-name"><%= @project.name %></span>
    <span class="editor-format"><%= @project.format.humanize %></span>

    <% if @project.paginated? %>
      <%= button_to "+Page", project_pages_path(@project), form: { class: "inline-form" } %>
    <% else %>
      <%= button_to "↓ Longer", grow_project_page_path(@project, @pages.first), method: :patch, form: { class: "inline-form" } %>
      <%= button_to "↑ Shorter", shrink_project_page_path(@project, @pages.first), method: :patch, form: { class: "inline-form" }, disabled: @pages.first.height_units.to_i <= 1 %>
    <% end %>
    <button type="button" disabled>Undo</button>
    <button type="button" disabled>Redo</button>
    <button type="button" data-action="click->theme#toggle">Theme</button>
    <%= render "projects/save_dialog" %>
    <button type="button" disabled>Export</button>

    <button type="button" class="header-focus-exit" data-action="click->editor#exitFocus" aria-label="Exit zoomed-in panel">✕</button>

    <%= button_to "Sign out", session_path, method: :delete, form: { class: "inline-form" } %>
  </header>

  <main class="editor-canvas">
    <%= tag.div flash[:alert], class: "flash flash--alert" if flash[:alert] %>
    <%= tag.div flash[:notice], class: "flash flash--notice" if flash[:notice] %>

    <% if @pages.all? { |page| page.data["panels"].blank? } %>
      <p class="empty-state-hint" data-editor-target="emptyHint">
        This comic is empty — add a panel or apply a preset from the Layout tools below.
      </p>
    <% end %>

    <div class="pages">
      <% @pages.each do |page| %>
        <div class="page"
             data-controller="document-store panel text"
             data-editor-target="page"
             data-action="document-store:change->panel#refresh document-store:change->text#refresh click->editor#selectPage panel:selected->editor#selectPage panel:focused->editor#updateFocusIndicator panel:unfocused->editor#updateFocusIndicator panel:focused->editor#syncPhotoControls panel:unfocused->editor#syncPhotoControls document-store:change->editor#syncPhotoControls panel:focused->text#hide panel:unfocused->text#show text:selectionChanged->editor#syncTextLayerButton document-store:change->editor#syncTextLayerButton"
             data-document-store-project-id-value="<%= @project.id %>"
             data-document-store-page-id-value="<%= page.id %>"
             data-document-store-initial-data-value="<%= page.data.to_json %>">
          <div class="page-toolbar">
            <span class="page-label"><%= page.name %></span>
            <% if @project.paginated? && @pages.size > 1 %>
              <%= button_to "Delete page", project_page_path(@project, page), method: :delete, class: "btn--subtle", form: { class: "inline-form" } %>
            <% end %>
          </div>
          <svg class="page-canvas" data-panel-target="canvas" data-text-target="canvas" data-action="pointerdown->panel#deselectOnBackgroundPointerDown" viewBox="0 0 <%= @project.page_width %> <%= page.height %>" role="img" aria-label="<%= page.name %>"></svg>
          <div class="page-text-layer" data-text-target="layer"></div>
        </div>
      <% end %>
    </div>
  </main>

  <footer class="editor-footer">
    <nav class="mode-tabs">
      <button type="button" class="mode-tab mode-tab--active" data-editor-target="tab" data-mode="layout" data-action="click->editor#switchMode">Layout</button>
      <button type="button" class="mode-tab" data-editor-target="tab" data-mode="draw" data-action="click->editor#switchMode">Draw</button>
      <button type="button" class="mode-tab" data-editor-target="tab" data-mode="letter" data-action="click->editor#switchMode">Letter</button>
    </nav>

    <div class="contextual-tray" data-editor-target="tray" data-mode="layout">
      <div class="tray-section">
        <span class="tray-label">Add panel</span>
        <button type="button" data-action="click->editor#addPanel" data-editor-shape-param="box">Box</button>
        <button type="button" data-action="click->editor#addPanel" data-editor-shape-param="slant">Slant</button>
        <button type="button" data-action="click->editor#addPanel" data-editor-shape-param="round">Round</button>
        <button type="button" data-action="click->editor#addPanel" data-editor-shape-param="burst">Burst</button>
      </div>
      <div class="tray-section">
        <span class="tray-label">Presets</span>
        <% ProjectsHelper::LAYOUT_PRESETS.fetch(@project.format).each do |preset_name| %>
          <button type="button" data-action="click->editor#applyPreset" data-editor-preset-param="<%= preset_name %>"><%= preset_name %></button>
        <% end %>
      </div>
      <div class="tray-section">
        <span class="tray-label">View</span>
        <button type="button" class="ink-tool" data-editor-target="hideTextsButton" data-action="click->editor#toggleTextsVisibility">Hide text</button>
      </div>
    </div>
    <div class="contextual-tray" data-editor-target="tray" data-mode="draw" hidden>
      <nav class="draw-layer-tabs">
        <button type="button" class="draw-layer-tab draw-layer-tab--active" data-editor-target="drawLayerTab" data-layer="ink" data-action="click->editor#selectDrawLayer">Ink</button>
        <button type="button" class="draw-layer-tab" data-editor-target="drawLayerTab" data-layer="photo" data-action="click->editor#selectDrawLayer">Photo</button>
      </nav>

      <div class="draw-layer-panel" data-editor-target="drawLayerPanel" data-layer="ink">
        <div class="tray-section">
          <span class="tray-label">Tool</span>
          <button type="button" class="ink-tool" data-editor-target="drawTool" data-tool="pen" data-action="click->editor#selectDrawTool">✎ Pen</button>
          <button type="button" class="ink-tool" data-editor-target="drawTool" data-tool="marker" data-action="click->editor#selectDrawTool">🖊 Marker</button>
          <button type="button" class="ink-tool" data-editor-target="drawTool" data-tool="eraser" data-action="click->editor#selectDrawTool">⌫ Eraser</button>
        </div>
        <div class="tray-section">
          <span class="tray-label">Color</span>
          <% EditorHelper::INK_COLORS.each do |hex| %>
            <button type="button" class="ink-color" style="background-color: <%= hex %>;" data-editor-target="drawColor" data-color="<%= hex %>" data-action="click->editor#selectDrawColor" aria-label="Ink color <%= hex %>"></button>
          <% end %>
        </div>
        <div class="tray-section">
          <span class="tray-label">Size</span>
          <button type="button" class="ink-size" data-editor-target="drawSize" data-size="s" data-action="click->editor#selectDrawSize">S</button>
          <button type="button" class="ink-size" data-editor-target="drawSize" data-size="m" data-action="click->editor#selectDrawSize">M</button>
          <button type="button" class="ink-size" data-editor-target="drawSize" data-size="l" data-action="click->editor#selectDrawSize">L</button>
        </div>
      </div>

      <div class="draw-layer-panel" data-editor-target="drawLayerPanel" data-layer="photo" hidden>
        <div class="tray-section" data-editor-target="photoInsert">
          <span class="tray-label">Insert</span>
          <button type="button" data-action="click->editor#choosePhoto">Photos</button>
          <button type="button" data-action="click->editor#capturePhoto">Camera</button>
          <span class="tray-hint">Zoom into a panel first, then insert a photo.</span>
          <input type="file" id="photo-file-input" accept="image/*" hidden data-editor-target="photoFileInput" data-action="change->editor#uploadPhoto">
          <input type="file" id="photo-camera-input" accept="image/*" capture="environment" hidden data-editor-target="cameraFileInput" data-action="change->editor#uploadPhoto">
        </div>
        <div class="tray-flow" data-editor-target="photoFit" hidden>
          <nav class="draw-layer-tabs">
            <button type="button" class="draw-layer-tab draw-layer-tab--active" data-editor-target="photoSubTab" data-subtab="fit" data-action="click->editor#selectPhotoSubTab">Fit</button>
            <button type="button" class="draw-layer-tab" data-editor-target="photoSubTab" data-subtab="adjust" data-action="click->editor#selectPhotoSubTab">Adjust</button>
          </nav>

          <div class="tray-flow" data-editor-target="photoSubPanel" data-subtab="fit">
            <div class="tray-section">
              <span class="tray-label">Scale</span>
              <input type="range" min="20" max="300" value="100" data-editor-target="photoScale" data-action="input->editor#updatePhotoScale">
              <span class="tray-label">Rotate</span>
              <input type="range" min="-45" max="45" value="0" data-editor-target="photoRotate" data-action="input->editor#updatePhotoRotate">
            </div>
            <div class="tray-section">
              <span class="tray-hint">Drag the photo to reposition it.</span>
              <button type="button" class="ink-tool" data-editor-target="photoFlip" data-action="click->editor#flipPhoto">Flip</button>
              <button type="button" class="ink-tool" data-editor-target="photoCover" data-action="click->editor#togglePhotoCover">Fill panel</button>
            </div>
          </div>

          <div class="tray-flow" data-editor-target="photoSubPanel" data-subtab="adjust" hidden>
            <div class="tray-section">
              <span class="tray-label">Bright</span>
              <input type="range" min="-100" max="100" value="0" data-editor-target="photoBright" data-action="input->editor#updatePhotoBright">
              <span class="tray-label">Contrast</span>
              <input type="range" min="-100" max="100" value="0" data-editor-target="photoContrast" data-action="input->editor#updatePhotoContrast">
            </div>
            <div class="tray-section">
              <span class="tray-label">Hue</span>
              <input type="range" min="-180" max="180" value="0" data-editor-target="photoHue" data-action="input->editor#updatePhotoHue">
              <span class="tray-label">Saturation</span>
              <input type="range" min="-100" max="100" value="0" data-editor-target="photoSat" data-action="input->editor#updatePhotoSat">
            </div>
            <div class="tray-section">
              <span class="tray-label">Look</span>
              <button type="button" class="ink-tool" data-editor-target="photoLook" data-look="none" data-action="click->editor#selectPhotoLook">None</button>
              <button type="button" class="ink-tool" data-editor-target="photoLook" data-look="ink_bw" data-action="click->editor#selectPhotoLook">Ink B&amp;W</button>
              <button type="button" class="ink-tool" data-editor-target="photoLook" data-look="pop" data-action="click->editor#selectPhotoLook">Pop</button>
              <button type="button" class="ink-tool" data-editor-target="photoLook" data-look="vintage" data-action="click->editor#selectPhotoLook">Vintage</button>
            </div>
          </div>

          <div class="tray-section">
            <button type="button" data-action="click->editor#removePhoto">Remove</button>
          </div>
        </div>
      </div>

      <div class="tray-section">
        <button type="button" data-action="click->editor#exitFocus">Whole page</button>
        <span class="tray-hint">Tap a panel to zoom in and draw.</span>
      </div>
    </div>
    <div class="contextual-tray" data-editor-target="tray" data-mode="letter" hidden>
      <div class="tray-section">
        <span class="tray-label">Add</span>
        <button type="button" data-action="click->editor#addText" data-editor-kind-param="speech">Speech</button>
        <button type="button" data-action="click->editor#addText" data-editor-kind-param="caption">Caption</button>
        <button type="button" data-action="click->editor#addText" data-editor-kind-param="narration">Narration</button>
      </div>
      <div class="tray-section">
        <span class="tray-label">Layer</span>
        <button type="button" data-editor-target="textLayerButton" data-action="click->editor#toggleTextLayer" disabled>⬆ Bring to front</button>
      </div>
      <div class="tray-section">
        <span class="tray-hint">Drag to move, corner handle to resize, double-tap to edit its text.</span>
      </div>
    </div>
  </footer>
</div>
