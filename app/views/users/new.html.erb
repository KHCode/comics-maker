<h1>Create an account</h1>

<% if @user.errors.any? %>
  <ul class="field-errors">
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user do |form| %>
  <%= form.label :name %><br>
  <%= form.text_field :name, required: true, autofocus: true %><br>

  <%= form.label :email %><br>
  <%= form.email_field :email, required: true, autocomplete: "username" %><br>

  <%= form.label :password %><br>
  <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %><br>

  <%= form.submit "Sign up" %>
<% end %>

<br>
<%= link_to "Sign in instead", new_session_path %>
